{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lv-rqa-work-item/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_item_id",
    "objective",
    "role",
    "risk",
    "input_identity",
    "context_refs",
    "allowed_actions",
    "forbidden_actions",
    "expected_terminal_result",
    "qa_requirement",
    "founder_gate",
    "confidentiality",
    "budget",
    "replay_identity"
  ],
  "properties": {
    "schema_version": { "const": "lv-rqa-work-item/v1" },
    "work_item_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "objective": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "role": { "enum": ["research", "qa"] },
    "risk": { "enum": ["low", "medium", "high", "live"] },
    "input_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit_sha", "tree_sha"],
      "properties": {
        "repository": { "type": "string", "minLength": 1, "maxLength": 200 },
        "commit_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "tree_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "context_refs": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
    "allowed_actions": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
    "forbidden_actions": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
    "expected_terminal_result": { "type": "string", "minLength": 1, "maxLength": 128 },
    "qa_requirement": { "enum": ["none", "one", "dual", "installed-state", "security"] },
    "founder_gate": { "type": "boolean" },
    "confidentiality": { "enum": ["public", "confidential-engineering", "restricted-rd"] },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_worker_runs"],
      "properties": {
        "max_worker_runs": { "type": "integer", "minimum": 1, "maximum": 20 },
        "max_ai_credits": { "type": "number", "minimum": 0 },
        "max_actions_runtime_minutes": { "type": "number", "minimum": 0 }
      }
    },
    "replay_identity": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "dependencies": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 128 } }
  }
}
