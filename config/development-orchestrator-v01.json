{
  "version": "lv-development-orchestrator-v0.1",
  "states": [
    "active",
    "blocked",
    "ready-for-qa",
    "qa-failed",
    "qa-passed",
    "ready-for-core",
    "waiting-founder",
    "live-test",
    "closed"
  ],
  "transitions": {
    "active": ["blocked", "ready-for-qa", "waiting-founder", "closed"],
    "blocked": ["active", "waiting-founder", "closed"],
    "ready-for-qa": ["qa-failed", "qa-passed"],
    "qa-failed": ["active", "ready-for-qa"],
    "qa-passed": ["ready-for-core", "waiting-founder", "closed"],
    "ready-for-core": ["active", "blocked", "waiting-founder", "live-test"],
    "waiting-founder": ["active", "blocked", "ready-for-core", "live-test", "closed"],
    "live-test": ["active", "blocked", "closed"],
    "closed": []
  },
  "owners": ["core", "projection", "rookie", "dynasty", "idp", "opportunity", "ui", "qa", "product"],
  "risks": ["low", "medium", "high"],
  "types": ["bug", "feature", "research", "ui", "infrastructure"],
  "priorities": ["urgent", "high", "normal"],
  "founder_gates": ["release", "data-license", "production-model-promotion", "business-decision"],
  "founder_gate_required_for": [
    "production Dynasty Value architecture changes",
    "first production activation of major numerical models",
    "public launch",
    "pricing",
    "paid data licensing",
    "material infrastructure spending",
    "legal/privacy decisions",
    "partnerships",
    "major release decisions explicitly marked Founder-gated"
  ],
  "exact_sha_contract": {
    "qa_pass_requires_tested_sha": true,
    "head_change_invalidates_qa_pass": true,
    "integration_fails_closed_on_stale_qa": true
  },
  "inboxes": {
    "qa": "status:ready-for-qa",
    "core": "status:ready-for-core",
    "projection": "owner:projection AND (status:active OR status:qa-failed)",
    "rookie": "owner:rookie AND (status:active OR status:qa-failed)",
    "dynasty": "owner:dynasty AND (status:active OR status:qa-failed)",
    "idp": "owner:idp AND (status:active OR status:qa-failed)",
    "opportunity": "owner:opportunity AND (status:active OR status:qa-failed OR status:blocked)",
    "ui": "owner:ui AND (status:active OR status:qa-failed)",
    "product": "owner:product AND status:active"
  }
}
